{
  "name": "@jacob-z/aicodegather",
  "type": "module",
  "version": "1.6.0",
  "description": "AI code edit tracking: captures diffs from Edit/Write tools and optionally reports to a configurable analytics endpoint",
  "author": { "name": "Jacob" },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/JacobZyy/jacob-omp-collections", "directory": "packages/aicodegather" },
  "omp": {
    "extensions": ["./src/index.ts"]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "files": ["src"],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.9.1"
  }
}
