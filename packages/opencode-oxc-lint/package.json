{
  "name": "@jacob-z/opencode-oxc-lint",
  "type": "module",
  "version": "0.6.1",
  "description": "Run oxfmt + oxlint immediately after each edit in opencode, with LLM-visible diagnostics and max-hints loop prevention",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "bun-types": "^1.3.14",
    "tsdown": "^0.22.3"
  }
}
